# Raw and derived data are never committed. They are public and are re-fetched
# from CDC/USDA at build time; provenance lives in data/raw/MANIFEST.csv and
# integrity is pinned by docs/checksums.lock (both of which ARE committed).
data/raw/*
!data/raw/.gitkeep
!data/raw/MANIFEST.csv
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Generated outputs remain fully reproducible from source, but the figures and
# tables ARE committed: a reader should be able to see every result without
# installing R or rebuilding. They are regenerated by `make all` and their
# hashes are pinned in docs/artefact_checksums.csv, so a stale committed output
# is detectable rather than silent.
#
# Run logs stay ignored: they embed per-run wall-clock timestamps and would
# produce a spurious diff on every rebuild.
outputs/logs/*
!outputs/logs/.gitkeep

# renv: the lockfile is committed, the library is not.
renv/library/
renv/staging/
renv/local/
renv/python/
renv/sandbox/

# R session cruft
.Rhistory
.RData
.Rproj.user/
*.Rproj
.Rapp.history

# OS
.DS_Store
Thumbs.db
desktop.ini
